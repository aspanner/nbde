<!-- Isolated: no NAT/forward — VMs here cannot reach Tang on nbde-trusted. -->
<network>
  <name>nbde-isolated</name>
  <bridge name='virbr-nbde-i' stp='on' delay='0'/>
  <ip address='192.168.211.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.211.10' end='192.168.211.99'/>
    </dhcp>
  </ip>
</network>
