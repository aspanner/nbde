# Copy to config.env and adjust. Sourced by all scripts.

# Prefer system URI after: sudo ./scripts/host-enable-libvirt.sh $USER  (then re-login)
export LIBVIRT_DEFAULT_URI="${LIBVIRT_DEFAULT_URI:-qemu:///system}"

# Disks in /tmp so the qemu user can read them
export IMAGE_DIR="${IMAGE_DIR:-/tmp/nbde-vm-images}"

# RHEL 9+ cloud/KVM qcow2 — required before creating VMs
#   https://console.redhat.com/insights/image-builder
export RHEL_BASE_IMAGE="${RHEL_BASE_IMAGE:-${IMAGE_DIR}/rhel-base.qcow2}"

# Optional RHSM registration for fresh cloud images
# export RHSM_ORG=12345678
# export RHSM_ACTIVATION_KEY=my-key

export SSH_PUBKEY="${SSH_PUBKEY:-${HOME}/.ssh/id_rsa.pub}"
export SSH_USER="${SSH_USER:-redhat}"
export SSH_PASS="${SSH_PASS:-redhat}"

export TANG_VM_NAME="${TANG_VM_NAME:-nbde-tang}"
export TANG_RAM_MB="${TANG_RAM_MB:-1024}"
export TANG_VCPUS="${TANG_VCPUS:-1}"
export TANG_DISK_GB="${TANG_DISK_GB:-10}"

export CLIENT_VM_NAME="${CLIENT_VM_NAME:-nbde-client}"
export CLIENT_RAM_MB="${CLIENT_RAM_MB:-2048}"
export CLIENT_VCPUS="${CLIENT_VCPUS:-2}"
export CLIENT_DISK_GB="${CLIENT_DISK_GB:-15}"
export CLIENT_DATA_DISK_GB="${CLIENT_DATA_DISK_GB:-2}"

export NET_TRUSTED="${NET_TRUSTED:-nbde-trusted}"
export NET_ISOLATED="${NET_ISOLATED:-nbde-isolated}"

# auto | network | firewall
export ISOLATION_MODE="${ISOLATION_MODE:-auto}"
export NET_FALLBACK="${NET_FALLBACK:-default}"

export LUKS_PASSPHRASE="${LUKS_PASSPHRASE:-nbde-demo-passphrase}"
export LUKS_MAPPER_NAME="${LUKS_MAPPER_NAME:-nbde-data}"
